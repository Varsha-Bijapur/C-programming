#include <stdio.h>

void findDuplicates(int arr[], int size) {
    printf("Duplicate elements in the array: ");
    int found = 0; // Flag to check if any duplicate is found

    for (int i = 0; i < size; i++) {
        for (int j = i + 1; j < size; j++) {
            if (arr[i] == arr[j]) { // Check for duplicates
                printf("%d ", arr[i]);
                found = 1;
                break; // Avoid printing the same duplicate multiple times
            }
        }
    }

    if (!found) {
        printf("No duplicates found.");
    }
    
    printf("\n");
}

int main() {
    int arr[] = {4, 2, 7, 4, 8, 2, 9, 1, 7}; 
    int size = sizeof(arr) / sizeof(arr[0]);

    findDuplicates(arr, size);

    return 0;
}

